# ─── 服务配置 ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8765
DEBUG=false
LOG_LEVEL=INFO

# ─── OpenAI / 兼容 API 配置 ──────────────────────────────────
# 填写你的 API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 如使用第三方兼容接口（如 OneAPI、LocalAI），修改此地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型名称
OPENAI_MODEL=gpt-4o-mini

# ─── AI 参数 ─────────────────────────────────────────────────
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7
